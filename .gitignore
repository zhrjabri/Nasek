node_modules
dist
dist-owner
dist-admin
dist-harness
.verify
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json

# Environment. `.env.example` is committed and holds no secrets; everything
# else here does — including the anon key, which is public but still ties the
# repository to one specific project.
.env
.env.*
!.env.example
!.env.harness

# Generated by `npm run db:bundle` — regenerate, never edit or commit.
supabase/all-migrations.sql

# Supabase CLI machine-local state. Records which project this particular
# checkout is linked to, which is a property of the machine and not of NASEK.
supabase/.temp/

# Generated by `scripts/bundle-migrations.mjs` for one paste into the SQL
# editor, and stale the moment it is applied. `supabase/migrations/` is the
# record; a second copy of the same SQL is a second thing to keep in step.
supabase/PENDING_MIGRATIONS.sql
