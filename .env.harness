# =============================================================================
# The environment the verification harnesses build against.
#
# Committed, and deliberately empty. Vite loads `.env` first and then
# `.env.<mode>`, with the later file winning — so building a harness with
# `--mode harness` blanks the Supabase connection no matter what is in the
# developer's own `.env`.
#
# Without this, `npm run verify` behaved differently depending on who ran it.
# On a machine with a configured project the auth harness stopped exercising
# the local one-time-code path it exists to cover and started firing real
# requests at Supabase — so it was simultaneously not testing the thing it
# claimed to test, and sending traffic to a live project from a test run.
#
# The harnesses cover logic that must hold with or without a backend. The
# backend itself is checked separately, against the real project, by
# `npm run verify:backend`.
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
